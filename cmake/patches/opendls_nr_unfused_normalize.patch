-  return s2[0] + s2[1];
+// Tree sum over the 16 pair sums, in the reference order: stride 8, 4, 2, 1. Every add is
+// published as f16. `bits` holds r[lane] on lanes 0..15; the result lands on lane 0 and is
+// broadcast back to the half-warp.
+uint treeSum16(uint bits, uint lane, uint halfBase) {
+  uint other = subgroupShuffle(bits, halfBase + ((lane + 8u) & 31u));
+  if (lane < 8u) bits = f16Bits(f16FromBits(bits) + f16FromBits(other));
+  other = subgroupShuffle(bits, halfBase + ((lane + 4u) & 31u));
+  if (lane < 4u) bits = f16Bits(f16FromBits(bits) + f16FromBits(other));
+  other = subgroupShuffle(bits, halfBase + ((lane + 2u) & 31u));
+  if (lane < 2u) bits = f16Bits(f16FromBits(bits) + f16FromBits(other));
+  other = subgroupShuffle(bits, halfBase + ((lane + 1u) & 31u));
+  if (lane == 0u) bits = f16Bits(f16FromBits(bits) + f16FromBits(other));
+  return subgroupShuffle(bits, halfBase);
 }
 

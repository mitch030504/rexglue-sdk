-// stride 8/4/2/1 tree, every add published as FP16.
+//
+// One half-warp (32 lanes) per (token, head); 8 half-warps per 256-thread workgroup.
+// The scalar form of this kernel read one 192-byte head record per thread, so every warp
+// touched 32 cache lines to use 64 bytes of them (~50 GB/s measured). This form has each
+// half-warp load Q, K and V as three contiguous 64-byte records and reduces the 16 square
+// sums with subgroup shuffles in exactly the reference's tree order (stride 8/4/2/1).
 #extension GL_EXT_shader_explicit_arithmetic_types : require
+#extension GL_KHR_memory_scope_semantics : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_shuffle : require

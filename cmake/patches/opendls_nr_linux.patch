+namespace {
+// GLSL route on non-NVIDIA drivers: drop the NV-only extension requests and feature structs.
+void filterForAvailableExtensions(DeviceRequirements& req, const std::set<std::string>& available) {
+  std::vector<const char*> kept;
+  for (const char* ext : req.extensions) if (available.count(ext)) kept.push_back(ext);
+  req.extensions = kept;
+  const bool hasCuda = available.count(VK_NV_CUDA_KERNEL_LAUNCH_EXTENSION_NAME) != 0;
+  const bool hasSm = available.count(VK_NV_SHADER_SM_BUILTINS_EXTENSION_NAME) != 0;
+  const bool hasCoop2 = available.count(VK_NV_COOPERATIVE_MATRIX_2_EXTENSION_NAME) != 0;
+  // rebuild the pNext chain tail conditionally
+  VkPhysicalDeviceFeatures2& f = req.features;
+  VkBaseOutStructure** tail = (VkBaseOutStructure**)&f.pNext;
+  while (*tail) {
+    VkBaseOutStructure* node = (VkBaseOutStructure*)*tail;
+    if (node->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_SM_BUILTINS_FEATURES_NV && !hasSm) { *tail = node->pNext; continue; }
+    if (node->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COOPERATIVE_MATRIX_2_FEATURES_NV && !hasCoop2) { *tail = node->pNext; continue; }
+    tail = &node->pNext;
+  }
+  (void)hasCuda;
+}
+}  // namespace
+
+DeviceRequirements::DeviceRequirements(const std::set<std::string>& available) : DeviceRequirements() {
+  filterForAvailableExtensions(*this, available);
+}
